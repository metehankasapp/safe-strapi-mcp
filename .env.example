# Required for HTTP mode. Use a long random value.
MCP_API_KEY=replace-with-a-long-random-secret
PUBLIC_DOMAIN=mcp.example.com
ALLOWED_ORIGINS=https://mcp.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Required for multi-user production access. Access tokens must include
# `mcp:read` and/or `mcp:write`, plus a `projects` string array claim.
OIDC_ISSUER=https://auth.example.com/
OIDC_AUDIENCE=https://mcp.example.com/mcp
OIDC_JWKS_URI=https://auth.example.com/.well-known/jwks.json
PUBLIC_URL=https://mcp.example.com

# Strapi API tokens stay on the MCP server and are never exposed to agents.
STRAPI_API_TOKEN=replace-with-strapi-api-token

# stdio for a local MCP client, or http for a shared deployment
TRANSPORT=stdio
PORT=8787
PROJECTS_CONFIG=./config/projects.json
AUDIT_DB=./data/audit.sqlite
REQUEST_BODY_LIMIT=2mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
