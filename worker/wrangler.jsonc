{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "safe-strapi-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "../web/out",
    "binding": "ASSETS",
    "run_worker_first": ["/mcp", "/health", "/ready"]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["McpCoordinator"] },
    { "tag": "v2", "deleted_classes": ["McpCoordinator"] }
  ]
}
